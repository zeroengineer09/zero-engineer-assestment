PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
DATABASE_FILE=./database/certified-developer-test.db

# SMTP configuration required for email OTP password recovery.
# Use an SMTP provider account and a verified sender address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=ZERO ENGINEER No-Reply <no-reply@your-verified-domain.example>
